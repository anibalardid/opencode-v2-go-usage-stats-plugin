{
  "name": "opencode-v2-go-usage-stats-plugin",
  "version": "0.1.0",
  "description": "OpenCode Go subscription usage tracker for OpenCode 2 (CLI) — shows rolling, weekly and monthly limits in the sidebar.",
  "type": "module",
  "main": "./tui.js",
  "exports": {
    ".": "./tui.js",
    "./tui": "./tui.js"
  },
