    "tui.d.ts",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check": "bun scripts/check.ts"
  },
  "keywords": [
    "opencode",
    "opencode-2",
    "plugin",
    "tui",
    "go",
    "usage",
    "subscription",
    "sidebar"
